FROM python:3.12.10-alpine AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /code

RUN apk add --no-cache --virtual .build-deps \
    bash g++ gcc cargo git make postgresql-dev libffi-dev libc-dev linux-headers

COPY requirements.txt ./
COPY requirements ./requirements

RUN pip install --user -r requirements.txt --compile --no-cache-dir


FROM python:3.12.10-alpine

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/
ENV PATH=/home/appuser/.local/bin:$PATH

WORKDIR /code

RUN apk upgrade --no-cache && apk add --no-cache \
    bash libpq libxslt xmlsec ca-certificates openssl wget \
    && addgroup -S appgroup \
    && adduser -S appuser -G appgroup

COPY --from=builder /root/.local /home/appuser/.local

COPY manage.py .
COPY plane ./plane
COPY templates ./templates
COPY package.json .
COPY bin ./bin

RUN mkdir -p /code/plane/logs \
    && chmod +x ./bin/* \
    && chown -R appuser:appgroup /code /home/appuser/.local

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8000/api/health/ || exit 1

CMD ["./bin/docker-entrypoint-api.sh"]